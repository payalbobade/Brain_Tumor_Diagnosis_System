   "source": [
    "## 8. Evaluation on Test Set — All Three Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d05493d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_model(model, generator, name):\n",
    "    generator.reset()\n",
    "    preds = model.predict(generator)\n",
    "    y_pred = np.argmax(preds, axis=1)\n",
    "    y_true = generator.classes\n",
    "\n",
    "    acc = accuracy_score(y_true, y_pred)\n",
    "    print(f\"\\n===== {name} =====\")\n",
    "    print(f\"Test Accuracy: {acc*100:.2f}%\")\n",
    "    print(classification_report(y_true, y_pred, target_names=CLASS_NAMES))\n",
    "\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "    disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=CLASS_NAMES)\n",
    "    fig, ax = plt.subplots(figsize=(6, 6))\n",
    "    disp.plot(ax=ax, cmap='Blues', xticks_rotation=30)\n",
    "    plt.title(f'{name} — Confusion Matrix')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return acc\n",
    "\n",
    "acc_cnn = evaluate_model(cnn_model, test_generator, 'Custom CNN')\n",
    "acc_vgg = evaluate_model(vgg_model, test_generator, 'VGG16')\n",
    "acc_resnet = evaluate_model(resnet_model, test_generator, 'ResNet50')\n"
   ]
